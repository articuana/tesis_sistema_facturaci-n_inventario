<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Factura Electrónica SRI</title>
    <style>
        * { box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; }
        body { background-color: #f4f6f9; margin: 0; padding: 20px; color: #000; }
        .invoice-box { max-width: 800px; margin: auto; padding: 20px; background-color: #fff; font-size: 11px; line-height: 1.3; }
        .header-table { width: 100%; border-collapse: separate; border-spacing: 10px; margin-bottom: 10px; }
        .header-table td { vertical-align: top; }
        .issuer-box, .tax-box { border: 1px solid #000; border-radius: 8px; padding: 12px; }
        .issuer-box { width: 48%; }
        .tax-box { width: 52%; }
        .logo-placeholder { text-align: center; margin-bottom: 10px; }
        .logo-placeholder img { max-width: 120px; max-height: 80px; object-fit: contain; }
        .company-title { font-size: 13px; font-weight: bold; text-transform: uppercase; margin-bottom: 5px; }
        .company-legal { font-size: 11px; font-weight: bold; margin-bottom: 8px; }
        .issuer-details { font-size: 10px; }
        .issuer-details strong { display: inline-block; width: 100px; }
        .tax-box h3 { margin: 2px 0 6px 0; font-size: 14px; }
        .tax-line { margin-bottom: 4px; font-size: 10px; }
        .tax-line strong { display: inline-block; width: 140px; }
        .barcode-box { text-align: center; margin-top: 10px; }
        .barcode-box img { width: 90%; height: 35px; }
        .access-key-text { font-size: 9px; text-align: center; margin-top: 3px; }
        .client-box { width: 100%; border: 1px solid #000; padding: 8px 12px; margin-bottom: 10px; }
        .client-table { width: 100%; border-collapse: collapse; }
        .client-table td { padding: 2px 0; font-size: 10px; }
        .items-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        .items-table th, .items-table td { border: 1px solid #000; padding: 4px 6px; font-size: 9px; }
        .items-table th { text-align: center; font-weight: bold; background-color: #fff; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .bottom-table { width: 100%; border-collapse: collapse; }
        .bottom-table td { vertical-align: top; }
        .info-adicional-container { width: 58%; padding-right: 10px; }
        .totals-container { width: 42%; }
        .info-adicional-box { border: 1px solid #000; padding: 6px; margin-bottom: 10px; }
        .info-adicional-title { text-align: center; font-weight: bold; font-size: 9px; border-bottom: 1px solid #000; padding-bottom: 3px; margin-bottom: 4px; }
        .info-adicional-line { font-size: 9px; margin-bottom: 2px; }
        .payment-table { width: 100%; border-collapse: collapse; }
        .payment-table th, .payment-table td { border: 1px solid #000; padding: 4px; font-size: 9px; }
        .payment-table th { font-weight: bold; text-align: center; }
        .totals-table { width: 100%; border-collapse: collapse; }
        .totals-table td { border: 1px solid #000; padding: 3px 6px; font-size: 9px; }
        .totals-table td.label { font-weight: normal; }
    </style>
</head>
<body>
<div class="invoice-box">
    <table class="header-table">
        <tr>
            <td class="issuer-box">
                <div class="logo-placeholder">
                    <% if (empresa.logoUrl) { %>
                        <img src="<%= empresa.logoUrl %>" alt="Logo" />
                    <% } else { %>
                        <div style="font-size: 10px;">Logo no disponible</div>
                    <% } %>
                </div>
                <div class="company-title"><%= empresa.nombreComercial || empresa.nombre || 'Restaurante Orense' %></div>
                <div class="company-legal"><%= empresa.razonSocial || empresa.nombre || 'Restaurante Orense' %></div>
                <div class="issuer-details">
                    <div><strong>Dirección Matriz:</strong> <%= empresa.direccion || 'Av. Principal 123' %></div>
                    <div><strong>Dirección Sucursal:</strong> <%= empresa.direccionSucursal || empresa.direccion || 'Av. Principal 123' %></div>
                    <div><strong>Obligado a contabilidad:</strong> <%= empresa.obligadoContabilidad || 'NO' %></div>
                    <div><strong>Régimen:</strong> <%= empresa.regimen || 'Régimen General' %></div>
                </div>
            </td>
            <td class="tax-box">
                <div class="tax-line"><strong>R.U.C.:</strong> <%= empresa.ruc %></div>
                <h3>FACTURA</h3>
                <div class="tax-line"><strong>No.:</strong> <%= factura.numero %></div>
                <div class="tax-line"><strong>NÚMERO DE AUTORIZACIÓN</strong></div>
                <div class="tax-line" style="font-size: 9px;"><%= factura.autorizacion || 'N/A' %></div>
                <div class="tax-line"><strong>FECHA Y HORA DE AUTORIZACIÓN:</strong> <%= factura.fechaAutorizacion || factura.fecha || new Date().toLocaleString('es-EC') %></div>
                <div class="tax-line"><strong>AMBIENTE:</strong> <%= factura.ambiente || 'PRODUCCIÓN' %></div>
                <div class="tax-line"><strong>EMISIÓN:</strong> <%= factura.emision || 'NORMAL' %></div>
                <div class="tax-line" style="margin-top: 6px;"><strong>CLAVE DE ACCESO</strong></div>
                <% if (factura.barcode) { %>
                <div class="barcode-box" style="margin-top: 4px;">
                    <img src="<%= factura.barcode %>" alt="Código de barras" />
                    <div class="access-key-text"><%= factura.claveAcceso || 'N/A' %></div>
                </div>
                <% } else { %>
                <div class="tax-line" style="font-size: 9px; margin-top: 4px;"><%= factura.claveAcceso || 'N/A' %></div>
                <% } %>
            </td>
        </tr>
    </table>

    <div class="client-box">
        <table class="client-table">
            <tr>
                <td style="width: 100%;"><strong>Razón Social / Nombres y Apellidos:</strong> <%= cliente.nombre || 'Consumidor Final' %></td>
            </tr>
            <tr>
                <td><strong>Identificación:</strong> <%= cliente.identificacion || '9999999999999' %></td>
            </tr>
            <tr>
                <td><strong>Correo:</strong> <%= cliente.correo || 'No proporcionado' %></td>
            </tr>
            <tr>
                <td>
                    <span style="display:inline-block; width: 40%;"><strong>Fecha:</strong> <%= factura.fecha || new Date().toLocaleString('es-EC') %></span>
                    <% if (factura.placa) { %>
                        <span style="display:inline-block; width: 30%;"><strong>Placa / Matrícula:</strong> <%= factura.placa %></span>
                    <% } %>
                </td>
            </tr>
        </table>
    </div>

    <table class="items-table">
        <thead>
            <tr>
                <th style="width: 10%;">Cod. Princi</th>
                <th style="width: 10%;">Cantidad</th>
                <th style="width: 40%;">Descripción</th>
                <th style="width: 15%;">Detalle Adicional</th>
                <th style="width: 10%;">Precio Unitario</th>
                <th style="width: 8%;">Precio Total</th>
            </tr>
        </thead>
        <tbody>
            <% productos.forEach(function(producto) { %>
            <tr>
                <td class="text-center"><%= producto.codigoPrincipal || '' %></td>
                <td class="text-right"><%= Number(producto.cantidad || 0) %></td>
                <td><%= producto.descripcion || producto.nombre || '' %></td>
                <td><%= producto.detalleAdicional || '' %></td>
                <td class="text-right">$ <%= Number(producto.precioUnitario || producto.precio || 0).toFixed(2) %></td>
                <td class="text-right">$ <%= Number(producto.precioTotalSinImpuesto || producto.total || 0).toFixed(2) %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>

    <table class="bottom-table">
        <tr>
            <td class="info-adicional-container">
                <div class="info-adicional-box">
                    <div class="info-adicional-title">Información Adicional</div>
                    <div class="info-adicional-line"><strong>Email:</strong> <%= empresa.correo || 'N/A' %></div>
                </div>
                <table class="payment-table">
                    <thead>
                        <tr>
                            <th>Forma de pago</th>
                            <th style="width: 30%;">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (Array.isArray(factura.pagos) && factura.pagos.length) { %>
                            <% factura.pagos.forEach(function(pago) { %>
                            <tr>
                                <td><%= pago.formaPago || 'Efectivo' %></td>
                                <td class="text-right">$ <%= Number(pago.total || 0).toFixed(2) %></td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td><%= factura.formaPago || 'Efectivo' %></td>
                                <td class="text-right">$ <%= Number(total || 0).toFixed(2) %></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </td>
            <td class="totals-container">
                <table class="totals-table">
                    <tr>
                        <td class="label">SUBTOTAL IVA 15%</td>
                        <td class="text-right">$ <%= Number(subtotal || 0).toFixed(2) %></td>
                    </tr>
                    <% if (Number(factura.subtotalIva0 || 0) > 0) { %>
                    <tr>
                        <td class="label">SUBTOTAL IVA 0%</td>
                        <td class="text-right">$ <%= Number(factura.subtotalIva0).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <% if (Number(factura.subtotalNoObjetoIva || 0) > 0) { %>
                    <tr>
                        <td class="label">SUBTOTAL NO OBJETO DE IVA</td>
                        <td class="text-right">$ <%= Number(factura.subtotalNoObjetoIva).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <% if (Number(factura.subtotalExentoIva || 0) > 0) { %>
                    <tr>
                        <td class="label">SUBTOTAL EXENTO DE IVA</td>
                        <td class="text-right">$ <%= Number(factura.subtotalExentoIva).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <% if (Number(factura.subtotalSinImpuestos || 0) > 0) { %>
                    <tr>
                        <td class="label">SUBTOTAL SIN IMPUESTOS</td>
                        <td class="text-right">$ <%= Number(factura.subtotalSinImpuestos).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <% if (Number(factura.totalDescuento || factura.descuento || 0) > 0) { %>
                    <tr>
                        <td class="label">TOTAL DESCUENTO</td>
                        <td class="text-right">$ <%= Number(factura.totalDescuento || factura.descuento).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <% if (Number(factura.ice || 0) > 0) { %>
                    <tr>
                        <td class="label">ICE</td>
                        <td class="text-right">$ <%= Number(factura.ice).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <tr>
                        <td class="label">IVA 15%</td>
                        <td class="text-right">$ <%= Number(iva || 0).toFixed(2) %></td>
                    </tr>
                    <% if (Number(factura.totalDevolucionIva || 0) > 0) { %>
                    <tr>
                        <td class="label">TOTAL DEVOLUCIÓN IVA</td>
                        <td class="text-right">$ <%= Number(factura.totalDevolucionIva).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <% if (Number(factura.irbpnr || 0) > 0) { %>
                    <tr>
                        <td class="label">IRBPNR</td>
                        <td class="text-right">$ <%= Number(factura.irbpnr).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <% if (Number(factura.propina || 0) > 0) { %>
                    <tr>
                        <td class="label">PROPINA</td>
                        <td class="text-right">$ <%= Number(factura.propina).toFixed(2) %></td>
                    </tr>
                    <% } %>
                    <tr>
                        <td class="label" style="font-size: 12px; color: #000;"><strong>VALOR TOTAL</strong></td>
                        <td class="text-right" style="font-size: 12px; font-weight: bold;">$ <%= Number(total || 0).toFixed(2) %></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
</body>
</html>
